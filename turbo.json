{
  "$schema": "https://turbo.build/schema.json",

  // `.nvmrc` is not read by any task's command, but it pins the Node the tasks
  // run under, and a Node bump can change tsc/vitest output. Declaring it
  // globally means a version change busts every cached task rather than
  // silently serving results produced on the old runtime.
  "globalDependencies": [".nvmrc"],

  "tasks": {
    // Per-package tasks, implemented by `packages/*` and `apps/editor`.
    // `^build` is the whole point: a consumer's test/typecheck/lint must not run
    // until its dependencies have been built, or it typechecks against stale
    // (or absent) emit.
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "test": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^build"] },
    // `lint` is currently implemented only by the root task below: one
    // `eslint .` from the repo root covers `packages/*` too, because flat
    // config resolves from the root and the project service finds each
    // package's own tsconfig. A package only needs its own `lint` script once
    // it wants a rule set the root does not give it.
    "lint": { "dependsOn": ["^build"] },

    // Root tasks. Turbo only runs a root-package script when it is declared
    // with the `//#` prefix. The root no longer holds any application code, so
    // what is left here is repo-wide: the whole vitest run (every test lives in
    // a `packages/*` package and one root invocation collects them), the
    // typecheck of the tooling configs, and one `eslint .` over everything.
    // There is no `//#build` any more — building is `apps/editor`'s own task.
    //
    // `package.json`'s `test`/`typecheck` stay the real commands instead of
    // becoming `turbo run …` aliases: turbo invokes the same-named root script,
    // so an alias would re-enter turbo forever. The turbo-fronted entry points
    // are `gate` and `gate:full`, named distinctly for exactly that reason.
    // `ci` was the obvious name for the second and is unusable: `pnpm ci` is a
    // pnpm builtin and silently runs a clean install instead of the script.
    //
    // Inputs start from turbo's default (every git-tracked file in the package,
    // which for the root package is the repo) and subtract only what provably
    // cannot change a tsc or vitest result. Subtracting rather than listing
    // keeps a new source directory cache-correct by default; a missed entry in
    // a hand-written allowlist would serve a stale hit instead.
    "//#test": {
      "inputs": ["$TURBO_DEFAULT$", "!docs/**", "!*.md", "!.claude/**"]
    },
    "//#typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "!docs/**", "!*.md", "!.claude/**"]
    },
    "//#lint": {
      "inputs": ["$TURBO_DEFAULT$", "!docs/**", "!*.md", "!.claude/**"]
    }
  }
}
