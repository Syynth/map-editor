{
  "name": "map-editor",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node scripts/check-boundaries.mjs && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "boundaries": "node scripts/check-boundaries.mjs",
    "bench": "vitest bench --run --reporter=verbose",
    "shoot": "node scripts/screenshot.mjs",
    "tour": "node scripts/tour.mjs",
    "probe": "node scripts/probe.mjs"
  },
  "dependencies": {
    "@mantine/core": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@xstate/react": "7.0.0-alpha.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0",
    "xstate": "6.0.0-alpha.53"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "playwright": "^1.63.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
