{
  "name": "map-editor",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node scripts/check-boundaries.mjs && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "boundaries": "node scripts/check-boundaries.mjs",
    "bench": "vitest bench --run",
    "shoot": "node scripts/screenshot.mjs",
    "tour": "node scripts/tour.mjs",
    "probe": "node scripts/probe.mjs"
  },
  "dependencies": {
    "@xstate/react": "7.0.0-alpha.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.0",
    "xstate": "6.0.0-alpha.53"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.49.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
