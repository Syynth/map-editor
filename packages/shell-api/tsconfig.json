{
  "compilerOptions": {
    "target": "ES2022",
    // No `DOM`, no ambient `@types`: this is a contract, types and one
    // constant. The desktop shell implements it under Node and the editor
    // consumes it in a page, so it can assume neither.
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    // Composite and declaration-only for the same reasons as every other
    // package (#46): see `packages/registry/tsconfig.json`.
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "types": []
  },

  "exclude": ["src/**/*.test.ts"],

  "include": ["src"]
}
