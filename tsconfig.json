{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false
  },

  // The root compiles repo-wide tooling only: every line of application code
  // now lives in `apps/editor` or `packages/*`, each with its own tsconfig.
  // Path aliases are gone with it — `@editor/*` was declared here and again in
  // the Vite config, and the two had drifted; a workspace package name is the
  // one spelling that both tsc and the bundler resolve the same way.
  //
  // `tests` is repo-wide by the same definition — it holds the workspace
  // dependency-direction test, whose subject is the set of `package.json`s
  // rather than any one package's source, so it belongs to no package.
  //
  // `scripts` is deliberately NOT here (issue #28): those are `.mjs`, and
  // `allowJs` is off, so an `include` entry for them type-checks nothing —
  // `tsc --listFiles` confirms zero files from `scripts/` enter the program.
  // Turning them on would mean `allowJs` + `checkJs` against 770 lines of
  // unannotated Playwright drivers under this config's `strict`, which is a
  // real lift, not a two-line fix; ESLint's `scripts/**` globals block is
  // already what keeps them honest. Add the entry back, with `allowJs` and
  // `checkJs`, the day someone is willing to pay for that.
  "include": ["tests", "vitest.config.ts"]
}
