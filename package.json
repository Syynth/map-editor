{
  "name": "map-editor",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "vite",
    "gate": "turbo run test typecheck lint",
    "gate:full": "turbo run build test typecheck lint",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node scripts/check-boundaries.mjs && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "boundaries": "node scripts/check-boundaries.mjs",
    "bench": "vitest bench --run --reporter=verbose",
    "shoot": "node scripts/screenshot.mjs",
    "tour": "node scripts/tour.mjs",
    "probe": "node scripts/probe.mjs"
  },
  "dependencies": {
    "@map-editor/document": "workspace:*",
    "@map-editor/geometry": "workspace:*",
    "@map-editor/runtime": "workspace:*",
    "@mantine/core": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@xstate/react": "7.0.0-alpha.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0",
    "xstate": "6.0.0-alpha.53"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@map-editor/eslint-rules": "workspace:*",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
