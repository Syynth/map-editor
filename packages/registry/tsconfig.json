{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Same as the root config and `document`'s: `vitest`'s own declarations
    // reach for `DOM` and Node types this package deliberately does not load.
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    // #46, implementing #33's ruling that packages are built as if
    // publishable. `composite` is what makes `references` legal — a
    // referenced project must be composite — and it forbids `noEmit`, which
    // is why that setting is gone. `emitDeclarationOnly` splits the emit:
    // `tsc` owns `dist/*.d.ts`, `tsup` owns `dist/*.js` (see the root
    // `tsup.config.ts` for why the JS half needs a bundler at all).
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    // Inside `dist/` so it is covered by `.gitignore`, by `eslint.config.js`'s
    // `**/dist/**` ignore, and by this package's turbo `outputs` — tsc's
    // default with `emitDeclarationOnly` puts it beside the config instead,
    // where it would show up as an untracked file after every build.
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // No `DOM`, no ambient `@types`. This is rung 0 of the ladder (#3): every
    // other package sits on it, so anything it reached for — `window` for a
    // focus-scoped context, Node for a preferences file — would be reachable
    // from a worker, the headless editing session and the export CLI too. The
    // scoped availability holder lives in `ui` for exactly that reason; the
    // pure resolver here compiles without either.
    "types": []
  },

  // Tests and benches are typechecked by `tsconfig.typecheck.json`, not
  // built: a test file is not part of the published surface.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.bench.ts"],

  "include": ["src"]

  // No `references`: this package declares no workspace dependency.
}
