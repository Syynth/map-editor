{
  "name": "@map-editor/runtime",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./export": {
      "development": "./src/export.ts",
      "types": "./dist/export.d.ts",
      "default": "./dist/export.js"
    }
  },
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@map-editor/document": "workspace:*",
    "@map-editor/geometry": "workspace:*",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.0"
  }
}
