{
  "compilerOptions": {
    "target": "ES2022",
    // No `DOM`, though this package ships React glue: the hooks in
    // `src/react.tsx` reach React through its import, and the host actor
    // itself has to run where its tests do — a plain vitest worker with no
    // window (#10: a behavior test never renders). Leaving `DOM` out is what
    // checks that the actor never grows a `window` listener; the keymap's
    // keydown dispatcher (#66 step 6) belongs to the app, not here.
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Same as the other packages: `vitest`'s and `@types/react`'s own
    // declarations reach for `DOM` types this package deliberately does not
    // load, and checking a dependency's `.d.ts` is not this package's job.
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    // #46, implementing #33's ruling that packages are built as if
    // publishable. `composite` is what makes `references` legal — a
    // referenced project must be composite — and it forbids `noEmit`, which
    // is why that setting is gone. `emitDeclarationOnly` splits the emit:
    // `tsc` owns `dist/*.d.ts`, `tsup` owns `dist/*.js` (see the root
    // `tsup.config.ts` for why the JS half needs a bundler at all).
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    // Inside `dist/` so it is covered by `.gitignore`, by `eslint.config.js`'s
    // `**/dist/**` ignore, and by this package's turbo `outputs` — tsc's
    // default with `emitDeclarationOnly` puts it beside the config instead,
    // where it would show up as an untracked file after every build.
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // No ambient `@types`, matching every package: Node's globals staying out
    // means the day the host reaches for `process` or `fs` this config says
    // so, while the same file still builds under the root config.
    "types": []
  },

  // Tests and benches are typechecked by `tsconfig.typecheck.json`, not
  // built: a test file is not part of the published surface.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.bench.ts"],

  "include": ["src"],

  // `references` (#46) — one entry per workspace dependency, in the direction
  // `registry <- document <- geometry <- runtime <- viewport <- editor-host`
  // with `ui` and the features off the side. They were absent until now
  // because a referenced project must be `composite` and `composite` forbids
  // `noEmit`; #33 ruled that emit is what "built as if publishable" means, so
  // the emit came first and these follow it.
  "references": [
    { "path": "../document" },
    { "path": "../registry" }
  ]
}
