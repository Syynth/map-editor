{
  "compilerOptions": {
    "target": "ES2022",
    // `DOM` stays, for the same reason as `runtime`'s: these primitives are
    // `<input>`s and `<select>`s, so the element and event types are this
    // package's surface rather than an accident.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    // #46, implementing #33's ruling that packages are built as if
    // publishable. `composite` is what makes `references` legal — a
    // referenced project must be composite — and it forbids `noEmit`, which
    // is why that setting is gone. `emitDeclarationOnly` splits the emit:
    // `tsc` owns `dist/*.d.ts`, `tsup` owns `dist/*.js` (see the root
    // `tsup.config.ts` for why the JS half needs a bundler at all).
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    // Inside `dist/` so it is covered by `.gitignore`, by `eslint.config.js`'s
    // `**/dist/**` ignore, and by this package's turbo `outputs` — tsc's
    // default with `emitDeclarationOnly` puts it beside the config instead,
    // where it would show up as an untracked file after every build.
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // No ambient `@types`. React and Mantine are reached through their imports;
    // leaving Node's globals out means the day a primitive reaches for
    // `process` or `fs` the compiler says so here, while the same file still
    // builds under the root config.
    "types": []
  },

  // Tests and benches are typechecked by `tsconfig.typecheck.json`, not
  // built: a test file is not part of the published surface.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.bench.ts"],

  "include": ["src"]

  // No `references`: this package declares no workspace dependency.
}
