{
  "name": "map-editor",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.13.0 || ^24.0.0 || >=26.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @map-editor/editor dev",
    "gate": "turbo run test typecheck lint",
    "gate:full": "turbo run build test typecheck lint check-bundle-size",
    "preview": "pnpm --filter @map-editor/editor preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "lint": "eslint . --max-warnings=0",
    "bench": "vitest bench --run --reporter=verbose",
    "shoot": "node scripts/screenshot.mjs",
    "tour": "node scripts/tour.mjs",
    "probe": "node scripts/probe.mjs",
    "bake": "node scripts/bake-fixtures.mjs",
    "browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@map-editor/document": "workspace:*",
    "@map-editor/editor-host": "workspace:*",
    "@map-editor/eslint-rules": "workspace:*",
    "@map-editor/viewport": "workspace:*",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.63.0",
    "tsup": "8.5.1",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
