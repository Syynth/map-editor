{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // `true`, same as every other package config in this repo: `skipLibCheck`
    // only skips `.d.ts` files, so setting it `false` here to catch a broken
    // import in the ambient globals below would also turn on strict checking
    // for all 723 `.d.ts` files under `node_modules` (`tsc -p scripts
    // --listFiles | grep -c node_modules`) — a future @types/three,
    // @types/playwright or @types/node bump could then break this gate for
    // reasons that have nothing to do with `scripts/**`. The globals instead
    // live in `global.ts`, a regular module (see its own header) rather than
    // a `.d.ts` file, precisely so `skipLibCheck` can stay `true`: non-
    // declaration `.ts`/`.mjs` sources are always checked regardless of this
    // setting. Verified: pointing `global.ts`'s import at a nonexistent
    // package reports `TS2307` right at the `import` line with `skipLibCheck`
    // left `true`.
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "checkJs": true,
    // Nothing under `scripts/**` contains JSX. This is here because
    // `global.ts` types `window.__host` as `editor-host`'s `Host`, and that
    // package's barrel re-exports its React glue — a `.tsx` file this program
    // therefore has to parse. Without it the import fails with TS6142 and the
    // globals silently widen, which is the failure this config exists to
    // prevent (see `global.ts`'s header on why it is not a `.d.ts`).
    "jsx": "react-jsx",

    // `DOM` alongside Node's own types, unlike every package config in this
    // repo (see `packages/document/tsconfig.json`'s "no DOM" rationale): these
    // files are Node processes (`node:child_process`, `node:fs`) that also
    // hand Playwright closures — `page.evaluate(() => window.__viewport...)`,
    // `page.addInitScript(() => window.localStorage.clear())` — which run
    // inside the browser page, not this process. `checkJs` type-checks a
    // closure's body against whatever lib is in scope at its definition site,
    // with no way to tell it "this one runs somewhere else" the way a real
    // `tsc --noEmit` on the file that page.evaluate itself lives in would
    // know; the only way to check the Node half AND the browser-closure half
    // in the same program is to give both lib sets here.
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },

  // `scripts/**` stays out of the root tsconfig (its own comment explains why
  // that config specifically has no allowJs/checkJs) and gets this one
  // instead, run as its own `tsc -p scripts` step from the root `typecheck`
  // script — see issue #73. `include` covers `.test.mjs` too: they are still
  // Node source `tsc` can check, even though `eslint.config.js`'s
  // `OUTSIDE_THE_SYSTEM` exempts every file under `scripts/**`, tests
  // included, from lint (#38).
  "include": ["**/*.mjs", "global.ts"]
}
