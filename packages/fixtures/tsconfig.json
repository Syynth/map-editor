{
  "compilerOptions": {
    "target": "ES2022",
    // `DOM` is here for two things: `textures.ts`'s placeholder generator,
    // which draws with a 2D canvas and reads the pixels back out at its edge
    // (#47) — it came from `runtime`, which dropped `DOM` the same day, and
    // the canvas types moved with the only code that used them — and
    // `baked-dir.ts`'s `import.meta.resolve` and `URL`, both typed only by
    // this lib (`lib.dom.d.ts`'s `ImportMeta` declares `resolve`; `lib.es5.d.ts`'s
    // is deliberately empty, an augmentation point for whichever lib wants it).
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Same as the root config, and the same reason as `document`'s and
    // `geometry`'s: dependencies' declarations reach for Node types this
    // package does not load.
    "skipLibCheck": true,
    // For `src/baked.test.ts` alone: it imports `../baked/manifest.json` to
    // hold the checked-in bake to the live sample map, and a JSON import is
    // the one way to read that file with no Node types in this program.
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    // #46, implementing #33's ruling that packages are built as if
    // publishable. `composite` is what makes `references` legal — a
    // referenced project must be composite — and it forbids `noEmit`, which
    // is why that setting is gone. `emitDeclarationOnly` splits the emit:
    // `tsc` owns `dist/*.d.ts`, `tsup` owns `dist/*.js` (see the root
    // `tsup.config.ts` for why the JS half needs a bundler at all).
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    // Inside `dist/` so it is covered by `.gitignore`, by `eslint.config.js`'s
    // `**/dist/**` ignore, and by this package's turbo `outputs` — tsc's
    // default with `emitDeclarationOnly` puts it beside the config instead,
    // where it would show up as an untracked file after every build.
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // No ambient `@types`. A fixture is dev-only in the sense that nothing
    // shipped depends on it, but what it produces is real data the editor
    // loads: the sample map is built out of document verbs and sheet layout
    // and nothing else, and the generator's canvas never leaves `textures.ts`.
    // Leaving Node's globals out is what keeps the second half of that
    // compiler-checked: the day a fixture reaches for the filesystem to fake
    // something up, the compiler says so here. (`DOM` above means a fixture
    // reaching for a canvas is now a review question rather than a compile
    // error — the price of housing the one module that legitimately does.)
    "types": []
  },

  // Tests and benches are typechecked by `tsconfig.typecheck.json`, not
  // built: a test file is not part of the published surface, and this
  // package's own `baked.test.ts` imports `../baked/manifest.json`, outside
  // `rootDir` — which a build config cannot accept at all.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/**/*.bench.ts"],

  "include": ["src"],

  // `references` (#46) — one entry per workspace dependency, in the direction
  // `registry <- document <- geometry <- runtime <- viewport <- editor-host`
  // with `ui` and the features off the side. They were absent until now
  // because a referenced project must be `composite` and `composite` forbids
  // `noEmit`; #33 ruled that emit is what "built as if publishable" means, so
  // the emit came first and these follow it.
  "references": [
    { "path": "../document" },
    { "path": "../geometry" }
  ]
}
