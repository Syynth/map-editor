{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false
  },

  // The root compiles repo-wide tooling only: every line of application code
  // now lives in `apps/editor` or `packages/*`, each with its own tsconfig.
  // Path aliases are gone with it — `@editor/*` was declared here and again in
  // the Vite config, and the two had drifted; a workspace package name is the
  // one spelling that both tsc and the bundler resolve the same way.
  //
  // `tests` is repo-wide by the same definition — it holds the workspace
  // dependency-direction test, whose subject is the set of `package.json`s
  // rather than any one package's source, so it belongs to no package.
  //
  // `scripts` is deliberately NOT here (#73, superseding #28's deferral):
  // those are `.mjs`, and `allowJs`/`checkJs` against 770-plus lines of
  // Playwright drivers under this config's `strict` needs its own `lib`
  // (`DOM`, for the browser closures handed to `page.evaluate`) and its own
  // ambient globals (`scripts/global.d.ts`, typing the debug hooks
  // `apps/editor/src/editor/App.tsx` puts on `window`) that no other file
  // under this config wants — folding them in here would mean every root
  // file compiling against a `lib`/`types` set only `scripts/**` needs.
  // `scripts/tsconfig.json` carries that config instead, and the root
  // `typecheck` script (package.json) runs it as a second `tsc -p scripts`
  // invocation so `pnpm typecheck`/`pnpm gate` still cover it. #28's
  // deferral reasoned from `allowJs` being off entirely, which is no longer
  // true; #38's ESLint exemption for `scripts/**` is untouched — this issue
  // was scoped to typechecking only.
  "include": ["tests", "vitest.config.ts"]
}
