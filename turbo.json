{
  "$schema": "https://turbo.build/schema.json",

  // `.nvmrc` is not read by any task's command, but it pins the Node the tasks
  // run under, and a Node bump can change tsc/vitest output. Declaring it
  // globally means a version change busts every cached task rather than
  // silently serving results produced on the old runtime.
  //
  // `scripts/check-bundle-size.mjs` is here for the same reason, but a
  // different mechanism: turbo's default `inputs` for a task is that
  // package's own tracked files, and this script lives at the repo root,
  // outside `apps/editor`. Without listing it globally, editing the script
  // (a new ceiling, a different glob, a different dist dir) changes what
  // `check-bundle-size` does without changing any hash it is keyed on, so
  // turbo replays a cache hit from before the edit — verified: with the
  // script untracked here, dropping `DEFAULT_LIMIT_BYTES` to 1 still replayed
  // the prior green result (`cache hit, replaying logs …`); only `--force`
  // (which bypasses the cache entirely, same as this PR's own reachability
  // proof did) surfaced the failure.
  // `tsup.config.ts` joins them for the `check-bundle-size.mjs` reason
  // exactly: every package's `build` script runs `tsup --config
  // ../../tsup.config.ts`, so that file is an input to ten tasks and lives in
  // none of their packages. Turbo's default `inputs` is the package's own
  // tracked files, so without this entry a change to the shared emitter
  // config — the entry derivation, the output format, the target — changes
  // what every `build` produces without changing any hash it is keyed on, and
  // turbo replays the pre-edit output. Verified the same way #57 verified the
  // bundle-size script: with the file untracked here, editing it still
  // replayed a cache hit; listed, the same edit misses on every package.
  "globalDependencies": [".nvmrc", "scripts/check-bundle-size.mjs", "tsup.config.ts"],

  "tasks": {
    // Per-package tasks, implemented by `packages/*` and every `apps/*` package
    // that has one (`apps/editor`, and `apps/export-cli` since #48 revived it).
    // `^build` is the whole point: a consumer's test/typecheck/lint must not run
    // until its dependencies have been built, or it typechecks against stale
    // (or absent) emit.
    // #46: `build` is now implemented by every `packages/*` package as well —
    // `tsup` for `dist/*.js`, `tsc -p tsconfig.json` for `dist/*.d.ts` — so
    // `^build` is load-bearing rather than an inert edge over a graph with one
    // builder in it. `dist/**` already covers both halves and tsc's
    // `.tsbuildinfo`, which is written into `dist/` for exactly that reason.
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "test": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^build"] },
    // Reads apps/editor's own `dist/`, so it depends on THIS package's build
    // (not `^build`, which only orders a package after its dependencies).
    // #57: the only implementation is apps/editor's, the one package with a
    // `dist/` to measure.
    "check-bundle-size": { "dependsOn": ["build"] },
    // `lint` is currently implemented only by the root task below: one
    // `eslint .` from the repo root covers `packages/*` too, because flat
    // config resolves from the root and the project service finds each
    // package's own tsconfig. A package only needs its own `lint` script once
    // it wants a rule set the root does not give it.
    "lint": { "dependsOn": ["^build"] },

    // Root tasks. Turbo only runs a root-package script when it is declared
    // with the `//#` prefix. The root no longer holds any application code, so
    // what is left here is repo-wide: the whole vitest run (one root
    // invocation collects every test — `packages/*` and, since #57,
    // `scripts/check-bundle-size.test.mjs`, the first test under `scripts/`),
    // the typecheck of the tooling configs, and one `eslint .` over
    // everything. There is no `//#build` any more — building is
    // `apps/editor`'s own task.
    //
    // `package.json`'s `test`/`typecheck` stay the real commands instead of
    // becoming `turbo run …` aliases: turbo invokes the same-named root script,
    // so an alias would re-enter turbo forever. The turbo-fronted entry points
    // are `gate` and `gate:full`, named distinctly for exactly that reason.
    // `ci` was the obvious name for the second and is unusable: `pnpm ci` is a
    // pnpm builtin and silently runs a clean install instead of the script.
    //
    // Inputs start from turbo's default (every git-tracked file in the package,
    // which for the root package is the repo) and subtract only what provably
    // cannot change a tsc or vitest result. Subtracting rather than listing
    // keeps a new source directory cache-correct by default; a missed entry in
    // a hand-written allowlist would serve a stale hit instead.
    // No `^build` here, unlike `//#typecheck` below, and that is deliberate
    // (#46). vitest resolves each package's `exports` map through the
    // `development` condition and reads `packages/*/src`, so the suite never
    // needs a build — including `apps/export-cli/src/cli.build.test.ts`, which
    // runs a real `vite build` of its own inside the test process (that build
    // runs with `NODE_ENV=test`, so it resolves `development` too). Verified
    // by deleting every `packages/*/dist` and running the suite: 35 files,
    // 359 tests, green. Adding the edge would make every red test a build
    // away from being readable, for nothing.
    "//#test": {
      "inputs": ["$TURBO_DEFAULT$", "!docs/**", "!*.md", "!.claude/**"]
    },
    // `^build` here is not decoration (#46): `scripts/global.ts` types the
    // debug hooks the tour drives as `@map-editor/editor-host`'s `Host`, and
    // after #46 that name resolves through the package's `exports` map to
    // `dist/index.d.ts`. Verified by moving that one file aside: `tsc --noEmit
    // -p scripts` reports `TS2307: Cannot find module
    // '@map-editor/editor-host'`. `^build` from the ROOT package means the
    // root's own workspace dependencies (`document`, `editor-host`,
    // `eslint-rules`, `viewport`) and everything beneath them.
    "//#typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!docs/**", "!*.md", "!.claude/**"]
    },
    "//#lint": {
      "inputs": ["$TURBO_DEFAULT$", "!docs/**", "!*.md", "!.claude/**"]
    }
  }
}
